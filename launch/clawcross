#!/bin/bash
# ClawCross CLI launcher — model profile management
#
# Usage:
#   ./launch/clawcross model              # interactive model selection
#   ./launch/clawcross model gpt-4o       # set LLM_MODEL directly
#   ./launch/clawcross model add myapi    # create a full model profile

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT" || exit 1
exec python3 -m src.cli.commands.main "$@"
